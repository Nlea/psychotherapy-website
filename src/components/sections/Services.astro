---
interface Props {
  eyebrow: string;
  title: string;
  psychotherapie: {
    label: string;
    title: string;
    description: string;
    subsections: {
      title: string;
      text: string;
      showKurzgruppen?: boolean;
      note?: string;
      noteHighlight?: boolean;
      ctaText?: string;
      ctaHref?: string;
    }[];
  };
  coaching: {
    label: string;
    title: string;
    description: string;
    items: {
      title: string;
      content: string;
    }[];
  };
  adhs: {
    label: string;
    title: string;
    paragraphs: string[];
  };
  kurzgruppen: {
    label: string;
    title: string;
    description: string;
    items: {
      title: string;
      content: string;
    }[];
    format: string;
  };
  psychedelika: {
    label: string;
    title: string;
    paragraphs: string[];
    listTitle: string;
    list: {
      title: string;
      text: string;
    }[];
    closing: string[];
  };
  seminare: {
    label: string;
    title: string;
    description: string;
    ctaText: string;
    ctaHref: string;
  };
}

const {
  eyebrow,
  title,
  psychotherapie,
  coaching,
  adhs,
  kurzgruppen,
  psychedelika,
  seminare,
} = Astro.props;
---

<section class="section section-services" id="angebote">
  <div class="container">
    <p class="eyebrow">{eyebrow}</p>
    <h2>{title}</h2>

    <div class="bento-grid">
      <!-- Psychotherapie -->
      <div class="bento-card bento-card--large">
        <p class="eyebrow card-eyebrow">{psychotherapie.label}</p>
        <h3 class="card-title">{psychotherapie.title}</h3>
        <p class="card-text">{psychotherapie.description}</p>
        <div class="card-content">
          {
            psychotherapie.subsections.map((sub, index) => (
              <div
                class={`subsection ${index > 0 ? 'subsection-secondary' : ''}`}
              >
                <h4>{sub.title}</h4>
                <div class="subsection-text">
                  {sub.text.split('\n\n').map((paragraph) => (
                    <p>{paragraph}</p>
                  ))}
                </div>
                {sub.showKurzgruppen && (
                  <div class="group-shortcourses">
                    <h5>{kurzgruppen.title}</h5>
                    <p>{kurzgruppen.description}</p>
                    <div class="accordion accordion--inline">
                      {kurzgruppen.items.map((item) => (
                        <div class="accordion-item">
                          <button class="accordion-btn" aria-expanded="false">
                            {item.title}
                            <span class="accordion-icon">+</span>
                          </button>
                          <div class="accordion-body">
                            <p>{item.content}</p>
                          </div>
                        </div>
                      ))}
                      <div class="accordion-item">
                        <button class="accordion-btn" aria-expanded="false">
                          Format
                          <span class="accordion-icon">+</span>
                        </button>
                        <div class="accordion-body">
                          <p>{kurzgruppen.format}</p>
                        </div>
                      </div>
                    </div>
                  </div>
                )}
                {sub.note && (
                  <p
                    class={`subsection-note ${
                      sub.noteHighlight ? 'subsection-note--highlight' : ''
                    }`}
                  >
                    {sub.note}
                  </p>
                )}
                {sub.ctaText && sub.ctaHref && (
                  <a href={sub.ctaHref} class="subsection-cta">
                    {sub.ctaText} <span>→</span>
                  </a>
                )}
              </div>
            ))
          }
        </div>
      </div>
      <!-- Coaching -->
      <div class="bento-card bento-card--small">
        <p class="eyebrow card-eyebrow">{coaching.label}</p>
        <h3 class="card-title">{coaching.title}</h3>
        <p>{coaching.description}</p>
        <div class="accordion">
          {
            coaching.items.map((item) => (
              <div class="accordion-item">
                <button class="accordion-btn" aria-expanded="false">
                  {item.title}
                  <span class="accordion-icon">+</span>
                </button>
                <div class="accordion-body">
                  <p>{item.content}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
      <!-- ADHS Diagnostik -->
      <div class="bento-card bento-card--small bento-card--tinted">
        <p class="eyebrow card-eyebrow">{adhs.label}</p>
        <h3 class="card-title">{adhs.title}</h3>
        {adhs.paragraphs.map((p) => <p>{p}</p>)}
      </div>
      <!-- Seminare -->
      <div class="bento-card bento-card--small">
        <p class="eyebrow card-eyebrow">{seminare.label}</p>
        <h3 class="card-title">{seminare.title}</h3>
        <p>{seminare.description}</p>
        <a href={seminare.ctaHref} class="cta-link">
          {seminare.ctaText}
          <span>→</span>
        </a>
      </div>
      <!-- Psychedelika-informierte Begleitung -->
      <div class="bento-card bento-card--wide">
        <p class="eyebrow card-eyebrow">{psychedelika.label}</p>
        <h3 class="card-title">{psychedelika.title}</h3>
        {psychedelika.paragraphs.map((p) => <p>{p}</p>)}
        <p class="card-list-title">{psychedelika.listTitle}</p>
        <div class="accordion accordion--inline">
          {
            psychedelika.list.map((item) => (
              <div class="accordion-item">
                <button class="accordion-btn" aria-expanded="false">
                  {item.title}
                  <span class="accordion-icon">+</span>
                </button>
                <div class="accordion-body">
                  <p>{item.text}</p>
                </div>
              </div>
            ))
          }
        </div>
        {psychedelika.closing.map((p) => <p>{p}</p>)}
      </div>
    </div>
  </div>
</section>

<style>
  /* Bento Grid */
  .bento-grid {
    display: grid;
    gap: var(--sp-6);
  }
  @media (min-width: 768px) {
    .bento-grid {
      grid-template-columns: repeat(3, 1fr);
      grid-template-rows: auto auto;
    }
  }

  .bento-card {
    padding: var(--sp-8);
    border: 1px solid var(--border);
    background-color: var(--card);
    display: flex;
    flex-direction: column;
    min-width: 0;
    overflow-wrap: anywhere;
  }

  @media (min-width: 768px) {
    .bento-card {
      padding: var(--sp-10);
    }
  }

  .bento-card--large {
    grid-column: span 1;
    grid-row: span 1;
  }

  @media (min-width: 768px) {
    .bento-card--large {
      grid-column: span 2;
      grid-row: span 3;
    }
  }

  .bento-card--tinted {
    background-color: var(--secondary);
  }

  .group-shortcourses {
    margin-top: var(--sp-6);
    padding-top: var(--sp-4);
    border-top: 1px solid var(--border);
  }

  .group-shortcourses h5 {
    margin-bottom: var(--sp-3);
    font-size: var(--text-lg);
  }

  .card-list-title {
    margin-top: var(--sp-2);
  }

  .accordion.accordion--inline {
    margin: var(--sp-3) 0 var(--sp-6);
  }

  .bento-card--wide {
    grid-column: 1 / -1;
  }
  .card-text {
    margin-bottom: var(--sp-6);
    border-bottom: 2px solid var(--border);
    padding-bottom: var(--sp-6);
  }
  .subsection {
    padding-top: var(--sp-4);
    margin-bottom: var(--sp-6);
  }

  .subsection-secondary {
    border-top: 1px solid var(--border);
  }

  .subsection-text p + p {
    margin-top: var(--sp-4);
  }

  .subsection:last-child {
    margin-bottom: 0;
  }
  .subsection h4 {
    margin-bottom: var(--sp-3);
  }

  .subsection-note {
    margin-top: var(--sp-3);
    color: var(--accent);
  }

  .subsection-note--highlight {
    font-weight: 400;
  }

  .subsection-cta {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-1);
    padding: var(--sp-3) var(--sp-6);
    margin-top: var(--sp-3);
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--background);
    background: var(--accent);
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .subsection-cta:hover {
    opacity: 0.7;
  }

  .cta-link {
    display: inline-flex;
    align-items: center;
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    margin-top: auto;
    padding: var(--sp-3) 0;
    min-height: 44px;
    color: inherit;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .cta-link:hover {
    opacity: 0.7;
  }

  .cta-link span {
    margin-left: var(--sp-2);
  }

  .card-eyebrow {
    text-align: left;
  }
  .card-title {
    margin-bottom: var(--sp-4);
  }

  /* Accordion (base styles in global.css) */
  .accordion {
    margin-top: auto;
  }
</style>
